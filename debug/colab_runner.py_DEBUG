# debug/colab_runner.py_DEBUG

import subprocess
import sys
import shutil
from pathlib import Path
import time

# --- 來自 V55 的設定 ---
REPO_URL = "https://github.com/hsp1234-web/WEB_0802.git"
TARGET_BRANCH_OR_TAG = "0.7.0"

def log_header(title):
    print("\\n" + "="*80)
    print(f"=== {title.upper()} ===")
    print("="*80)

def run_and_print(command, cwd=None, project_name=""):
    """執行一個指令並立即印出其輸出。"""
    print(f"\\n>> [{project_name}] RUNNING: {' '.join(command)}")
    result = subprocess.run(
        command,
        capture_output=True,
        text=True,
        encoding='utf-8',
        cwd=cwd
    )
    print(f"   RETURN CODE: {result.returncode}")
    if result.stdout:
        print(f"   STDOUT:\\n---\\n{result.stdout.strip()}\\n---")
    if result.stderr:
        print(f"   STDERR:\\n---\\n{result.stderr.strip()}\\n---")
    return result.returncode == 0

def setup_environment(project_name: str, bootstrap_pip: bool):
    """
    一個無頭版本的 V55 環境設定函式。
    :param project_name: 測試用的目錄名稱。
    :param bootstrap_pip: 若為 True，則加入防禦性的 pip 引導程序。
    """
    log_header(f"Test with bootstrap_pip={bootstrap_pip}")
    base_path = Path("/content")
    project_path = base_path / project_name

    try:
        # 1. 清理舊目錄
        if project_path.exists():
            print(f"Cleaning up old directory: {project_path}")
            shutil.rmtree(project_path)

        # 2. Clone 專案
        if not run_and_print(["git", "clone", "--branch", TARGET_BRANCH_OR_TAG, "--depth", "1", REPO_URL, str(project_path)], project_name=project_name):
            print(f"\\n❌ [{project_name}] FATAL: Git clone failed. Aborting test.")
            return False

        # 3. 建立虛擬環境
        venv_path = project_path / ".venv"
        if not run_and_print(["uv", "venv", str(venv_path)], project_name=project_name):
            print(f"\\n❌ [{project_name}] FATAL: uv venv failed. Aborting test.")
            return False

        venv_python = venv_path / "bin" / "python"

        # 4. (可選) 引導程序安裝 pip
        if bootstrap_pip:
            if not run_and_print(["uv", "pip", "install", "--python", str(venv_python), "pip", "wheel"], project_name=project_name):
                print(f"\\n❌ [{project_name}] FATAL: pip bootstrap failed. Aborting test.")
                return False

        # 5. 安裝依賴 (最終測試)
        print(f"\\n>> [{project_name}] Final Check: Installing dependencies...")
        core_requirements_path = project_path / "requirements/requirements-core.txt"
        pip_install_command = [str(venv_python), "-m", "pip", "install", "-r", str(core_requirements_path)]
        install_success = run_and_print(pip_install_command, project_name=project_name)

        if install_success:
            print(f"\\n✅✅✅ [{project_name}] TEST SUCCEEDED ✅✅✅")
        else:
            print(f"\\n❌❌❌ [{project_name}] TEST FAILED ❌❌❌")

        return install_success

    except Exception as e:
        print(f"\\n🚨🚨🚨 An unexpected Python exception occurred in test {project_name}: {e}")
        return False


def main():
    log_header("Phoenix Heart Ultimate Diagnostic Script (Headless V55)")

    # --- 測試 A: 模擬 V55 當前邏輯 ---
    print("\\nStarting Test A: Simulating current V55 setup (expected to fail)...")
    success_A = setup_environment(project_name="WEB1_Test_A", bootstrap_pip=False)

    time.sleep(2) # 短暫延遲讓日誌更容易閱讀

    # --- 測試 B: 模擬帶有修復的 V55 邏輯 ---
    print("\\nStarting Test B: Simulating V55 setup with bootstrap fix (expected to succeed)...")
    success_B = setup_environment(project_name="WEB1_Test_B", bootstrap_pip=True)

    log_header("Final Results")
    print(f"Test A (Current V55 Logic) Result: {'SUCCESS' if success_A else 'FAILURE'}")
    print(f"Test B (With Bootstrap Fix) Result: {'SUCCESS' if success_B else 'FAILURE'}")

    print("\\n" + "-"*80)
    if not success_A and success_B:
        print("🎉🎉🎉 BINGO! The results are as expected. 🎉🎉🎉")
        print("This strongly confirms that the `pip` bootstrap is the necessary fix.")
    else:
        print("🤔 The results are unexpected. Further analysis is needed.")
    print("-"*80)

if __name__ == "__main__":
    main()
